# ─────────────────────────────────────────────────────────────────────────────
# GhostAlpha Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Environment variables OVERRIDE values set in config.toml.
#
# SECURITY: Never commit .env files. They are gitignored by default.
# The .env file is auto-loaded by dotenvy — no need to `source` it.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your real values
#   ghost-alpha screen            # .env is auto-loaded
#
# Or with Docker:
#   docker run --env-file .env ghost-alpha screen
# ─────────────────────────────────────────────────────────────────────────────

# ── Data Provider (Required) ─────────────────────────────────────────────────

# Finnhub API key — get one free at https://finnhub.io/register
GHOST_ALPHA_FINNHUB_API_KEY=

# ── Alerts — Telegram (Optional) ─────────────────────────────────────────────

# Telegram Bot token — create via @BotFather on Telegram
GHOST_ALPHA_TELEGRAM_BOT_TOKEN=

# Telegram chat/group ID — use @userinfobot to find yours
GHOST_ALPHA_TELEGRAM_CHAT_ID=

# ── Alerts — Discord (Optional) ──────────────────────────────────────────────

# Discord webhook URL — create in Server Settings > Integrations > Webhooks
GHOST_ALPHA_DISCORD_WEBHOOK_URL=

# ── Alerts — Generic Webhook / BYOA (Optional) ──────────────────────────────

# Custom webhook URL for POST requests (Slack, PagerDuty, custom endpoint, etc.)
GHOST_ALPHA_WEBHOOK_URL=

# Authorization header value for the webhook (e.g., "Bearer your-token-here")
GHOST_ALPHA_WEBHOOK_AUTH_HEADER=

# ── Storage (Optional) ───────────────────────────────────────────────────────

# Path to SQLite database file (default: ghost_alpha.db)
GHOST_ALPHA_DB_PATH=

# ── Logging (Optional) ───────────────────────────────────────────────────────

# Log level: trace, debug, info, warn, error (default: info)
GHOST_ALPHA_LOG_LEVEL=info

# ── MCP Server (Optional) ───────────────────────────────────────────────────

# Set to "true" to enable MCP server mode (used by ghost-alpha-mcp binary)
GHOST_ALPHA_MCP_ENABLED=false

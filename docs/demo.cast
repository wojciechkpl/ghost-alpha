[8.307035, "o", "\r\n  Available Screening Strategies\r\n  ─────────────────────────────────────────────────────────────\r\n\r\n  \u001b[1mbreakout            \u001b[0m Price/volume breakouts from consolidation bases — optimised for swing traders\r\n  \u001b[1mmean-reversion      \u001b[0m Buy quality stocks temporarily oversold in Bull/Sideways regimes — contrarian entries\r\n  \u001b[1mminervini           \u001b[0m Stage 2 uptrend momentum — buy stocks in confirmed uptrends before acceleration (default)\r\n  \u001b[1mtrend-strength      \u001b[0m Ride strong established trends: ADX > 30, all MAs aligned, RS percentile > 70\r\n\r\n  Usage: ghost-alpha screen --strategy <name>\r\n\r\n"]
